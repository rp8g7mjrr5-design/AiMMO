diff --git a/tests/unit/test_gameplay_protocol_v3.gd b/tests/unit/test_gameplay_protocol_v3.gd
new file mode 100644
index 0000000..bd02776
--- /dev/null
+++ b/tests/unit/test_gameplay_protocol_v3.gd
@@ -0,0 +1,202 @@
+extends TestCase
+## Protocol v3 end to end on one machine without a network: the Play child's RPCs exist for
+## every message the server sends, with matching argument counts; the RPCs re-emit Net's
+## signals; c2s_gather_start / c2s_gather_cancel / c2s_craft reach the server's handlers
+## (with the flood guard); and every snapshot carries the receiver's ack_seq.
+
+const ServerScript := preload("res://server/server.gd")
+const NetScript := preload("res://shared/net.gd")
+
+
+func _server(positions: Dictionary) -> Node:
+	var srv: Node = ServerScript.new()
+	srv.test_now = 100.0
+	for id in positions:
+		var ch := CharacterData.normalize({"name": "P%d" % id})
+		var p: Vector3 = positions[id]
+		ch.x = p.x
+		ch.y = p.y
+		ch.z = p.z
+		srv.sessions[id] = {"logged_in": true, "character": ch, "move": Vector2.ZERO, "yaw": 0.0, "seq": -1,
+			"last_chat": -1000.0, "last_gather": -1000.0, "channel": {}, "login_attempts": 0, "inv_dirty": false}
+	return srv
+
+
+func _day_node() -> Dictionary:
+	for n in ResourceNodes.all():
+		if n.kind == "ash":
+			return n
+	return {}
+
+
+func _sent(srv: Node, method: String) -> Array:
+	var out: Array = []
+	for m in srv.test_outbox:
+		if m[1] == method:
+			out.append([m[0], m[2]])
+	return out
+
+
+func _run(srv: Node, seconds: float) -> void:
+	var t := 0.0
+	while t < seconds:
+		srv.test_now += GameConfig.TICK_DT
+		t += GameConfig.TICK_DT
+		srv._tick()
+
+
+func _arg_count(node: Object, method: String) -> int:
+	for m in node.get_script().get_script_method_list():
+		if m.name == method:
+			return m.args.size()
+	return -1
+
+
+func test_version_is_three() -> void:
+	check_eq(GameConfig.PROTOCOL_VERSION, 3)
+
+
+func test_net_has_a_play_child_from_the_start() -> void:
+	var net: Node = NetScript.new()
+	check(net.play != null, "play exists before entering the tree")
+	check_eq(str(net.play.name), "Play", "path is Net/Play on every peer")
+	check(net.play.get_parent() == net, "child of Net")
+	for m in ["c2s_gather_start", "c2s_gather_cancel", "c2s_craft", "s2c_gather_begin", "s2c_gather_end",
+			"s2c_gather_result", "s2c_inventory", "s2c_nodes", "s2c_node_state", "s2c_craft_result"]:
+		check(net.play.has_method(m), "Play has %s" % m)
+		check(not net.has_method(m), "%s is not on Net itself (would renumber c2s_login)" % m)
+	net.free()
+
+
+func test_every_message_the_server_sends_has_a_matching_rpc() -> void:
+	# Drive a session through login state, a timed gather to the end, a cancel, a refused
+	# start, a craft and a snapshot, then check every captured message against the RPCs.
+	var node := _day_node()
+	var srv := _server({2: node.pos, 3: node.pos + Vector3(2, 0, 0)})
+	srv._send_world_state(2)
+	srv.test_now = 100.0
+	srv.gather_request(2, int(node.id))
+	_run(srv, 6.0)
+	srv.gather_request(3, int(node.id))
+	srv.gather_cancel(3, "stopped")
+	srv.gather_request(2, 999999)
+	srv.craft_request(2, "stone_axe")
+	srv._node_changed(int(node.id), false)
+	var net: Node = NetScript.new()
+	var seen := {}
+	for m in srv.test_outbox:
+		var method: String = m[1]
+		seen[method] = true
+		var target: Node = net if net.has_method(method) else (net.play if net.play.has_method(method) else null)
+		check(target != null, "%s has an RPC" % method)
+		if target != null:
+			check_eq(m[2].size(), _arg_count(target, method), "%s argument count" % method)
+	for want in ["s2c_snapshot", "s2c_gather_begin", "s2c_gather_end", "s2c_gather_result", "s2c_inventory",
+			"s2c_nodes", "s2c_node_state", "s2c_craft_result"]:
+		check(seen.has(want), "scenario covered %s" % want)
+	net.free()
+	srv.free()
+
+
+func test_play_rpcs_reemit_on_net() -> void:
+	var net: Node = NetScript.new()
+	var got: Array = []
+	net.gather_began.connect(func(p, n, s): got.append(["began", p, n, s]))
+	net.gather_ended.connect(func(p, n, r): got.append(["ended", p, n, r]))
+	net.gather_result.connect(func(i, c): got.append(["result", i, c]))
+	net.inventory.connect(func(items): got.append(["inv", items]))
+	net.nodes.connect(func(ids): got.append(["nodes", ids]))
+	net.node_state.connect(func(n, d): got.append(["state", n, d]))
+	net.craft_result.connect(func(r, ok, t): got.append(["craft", r, ok, t]))
+	net.play.s2c_gather_begin(2, 7, 2.0)
+	net.play.s2c_gather_end(2, 7, "done")
+	net.play.s2c_gather_result("ash_wood", 2)
+	net.play.s2c_inventory({"ash_wood": 2})
+	net.play.s2c_nodes([7, 9])
+	net.play.s2c_node_state(7, true)
+	net.play.s2c_craft_result("torch", true, "You make 3 torches.")
+	check_eq(got, [["began", 2, 7, 2.0], ["ended", 2, 7, "done"], ["result", "ash_wood", 2], ["inv", {"ash_wood": 2}],
+		["nodes", [7, 9]], ["state", 7, true], ["craft", "torch", true, "You make 3 torches."]])
+	net.free()
+
+
+func test_snapshot_carries_ack_seq_and_acks_first() -> void:
+	var net: Node = NetScript.new()
+	var order: Array = []
+	net.input_acked.connect(func(t, a): order.append(["ack", t, a]))
+	net.snapshot.connect(func(t, _e): order.append(["snap", t]))
+	net.s2c_snapshot(5, [2, 0.0, 0.0, 0.0, 0.0], 41)
+	check_eq(order, [["ack", 5, 41], ["snap", 5]], "ack arrives before the snapshot it belongs to")
+	net.free()
+
+
+func test_server_snapshot_has_each_receivers_own_seq() -> void:
+	var srv := _server({2: Vector3.ZERO, 3: Vector3(4, 0, 0)})
+	srv._on_input(2, 17, Vector2(1, 0), 0.0)
+	srv._on_input(2, 12, Vector2(0, 1), 0.0) # old seq: ignored, the ack stays at 17
+	srv._tick()
+	var acks := {}
+	for m in _sent(srv, "s2c_snapshot"):
+		acks[m[0]] = m[1][2]
+		check_eq(m[1].size(), 3, "tick, entries, ack_seq")
+	check_eq(acks, {2: 17, 3: -1}, "each player gets their own seq, -1 before any input")
+	srv.free()
+
+
+func test_gather_start_rpc_runs_the_timed_gather() -> void:
+	var node := _day_node()
+	var srv := _server({2: node.pos})
+	srv._on_gather_start(2, int(node.id))
+	var begins := _sent(srv, "s2c_gather_begin")
+	check_eq(begins.size(), 1, "began")
+	check_eq(begins[0][1][0], 2)
+	check_eq(begins[0][1][1], int(node.id))
+	_run(srv, float(begins[0][1][2]) + 0.2)
+	var ends := _sent(srv, "s2c_gather_end")
+	check_eq(ends.size(), 1)
+	check_eq(ends[0][1][2], "done")
+	check_eq(_sent(srv, "s2c_gather_result").size(), 1, "haul toast")
+	check(_sent(srv, "s2c_inventory").size() >= 1, "pack sent")
+	srv.free()
+
+
+func test_gather_cancel_rpc_stops_without_charge() -> void:
+	var node := _day_node()
+	var srv := _server({2: node.pos})
+	srv._on_gather_start(2, int(node.id))
+	srv._on_gather_cancel(2)
+	var ends := _sent(srv, "s2c_gather_end")
+	check_eq(ends.size(), 1)
+	check_eq(ends[0][1][2], "stopped")
+	check(not GatherChannel.is_active(srv.sessions[2].channel), "channel cleared")
+	check_eq(Inventory.total(srv.sessions[2].character.inventory), 0, "nothing paid")
+	check(srv.sessions[2].last_gather < 0.0, "no cooldown spent")
+	srv._on_gather_cancel(2) # nothing running: silent
+	check_eq(_sent(srv, "s2c_gather_end").size(), 1)
+	srv.free()
+
+
+func test_requests_from_logged_out_peers_are_ignored() -> void:
+	var node := _day_node()
+	var srv := _server({2: node.pos})
+	srv.sessions[2].logged_in = false
+	srv._on_gather_start(2, int(node.id))
+	srv._on_craft(2, "torch")
+	srv._on_gather_cancel(2)
+	srv._on_gather_start(99, int(node.id)) # never connected
+	check(srv.test_outbox.is_empty(), "nothing answered")
+	srv.free()
+
+
+func test_flooded_requests_are_dropped() -> void:
+	var srv := _server({2: Vector3(500, 0, 500)})
+	for i in 20:
+		srv._on_craft(2, "torch")
+	check_eq(_sent(srv, "s2c_craft_result").size(), 1, "one answer inside the gap")
+	srv.test_now += srv.PLAY_REQUEST_GAP + 0.01
+	srv._on_craft(2, "torch")
+	check_eq(_sent(srv, "s2c_craft_result").size(), 2, "answered again after the gap")
+	for i in 20:
+		srv._on_gather_start(2, 999999)
+	check_eq(_sent(srv, "s2c_gather_end").size(), 1, "gather start has its own gap")
+	srv.free()
