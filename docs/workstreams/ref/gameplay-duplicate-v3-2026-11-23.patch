diff --git a/tests/bot_test/behaviours/gameplay_gather_v3.gd b/tests/bot_test/behaviours/gameplay_gather_v3.gd
new file mode 100644
index 0000000..5d74f09
--- /dev/null
+++ b/tests/bot_test/behaviours/gameplay_gather_v3.gd
@@ -0,0 +1,268 @@
+extends "res://tests/bot_test/bot_behaviour.gd"
+## Bot behaviour (gameplay): protocol v3's real gathering, through the RPCs a player's
+## press of E uses (Net/Play), never chat.
+##
+## Every login: the server must send the pack (s2c_inventory) and the depleted-node list
+## (s2c_nodes) right away.
+## Long runs only (LONG_RUN, CI's 180 s run), once gameplay_gathering.gd is done for the
+## login (it runs after this behaviour each frame and steers the bot while active), the bot
+## walks to the nearest day node and:
+##   1. c2s_gather_start, then walks away as soon as s2c_gather_begin names it: the gather
+##      must end "moved" (or "far"), never "done";
+##   2. c2s_gather_start, then c2s_gather_cancel: must end "stopped";
+##   3. c2s_gather_start and holds still: must end "done", with s2c_gather_result and an
+##      s2c_inventory that holds the haul.
+## Other bots' gathers in view (s2c_gather_begin for another peer) are counted, and a node
+## another bot empties under us (the contested case) sends this bot on to the next node.
+## Refusals ("cooldown" from the client gather prompt's /gather, "depleted", "far") move on
+## or retry; only the three checks above can fail the run.
+
+const SETTLE := 1.0
+const LONG_RUN := 120.0
+const SEARCH_RADIUS := 40.0
+const MAX_NODES := 10
+const STOP_AT := 1.2
+const WALK_TIMEOUT := 20.0
+const NO_ANSWER := 2.0 ## reliable RPCs always get an answer; this is only a safety net
+const MAX_TRIES := 8
+const END_SLACK := 2.5
+
+enum Step { WAIT_FIRST, GOTO, START, WALKING, STOPPING, HOLDING, IDLE }
+enum Test { WALK_AWAY, CANCEL, HOLD, DONE }
+
+var _step := Step.IDLE
+var _test := Test.WALK_AWAY
+var _targets: Array = []
+var _target := -1
+var _login_nodes := 0
+var _since := 0.0
+var _next_at := 0.0
+var _tries := 0
+var _ends_by := 0.0
+var _walk := Vector2.ZERO
+var _got_inventory := false
+var _got_nodes := false
+var _logins := 0
+var _haul_item := ""
+var _haul_count := 0
+var started := 0
+var completed := 0
+var walked_off := 0
+var stopped := 0
+var contested := 0
+var refused := 0
+var others_seen := 0
+var shared_node := 0
+var node_states := 0
+var nodes_tried := 0
+var answered := 0
+
+
+func setup(net: Node) -> void:
+	net.gather_began.connect(_on_began)
+	net.gather_ended.connect(_on_ended)
+	net.gather_result.connect(_on_result)
+	net.inventory.connect(_on_inventory)
+	net.nodes.connect(func(_ids): _got_nodes = true)
+	net.node_state.connect(func(_n, _d): node_states += 1)
+
+
+func on_login(_reconnect: bool, _character: Dictionary) -> void:
+	if _logins > 0:
+		_check_login_state()
+	_logins += 1
+	_got_inventory = false
+	_got_nodes = false
+	_haul_item = ""
+	_step = Step.WAIT_FIRST if float(bot.duration) >= LONG_RUN else Step.IDLE
+	_test = Test.WALK_AWAY
+
+
+func _check_login_state() -> void:
+	if not _got_inventory:
+		fail("no s2c_inventory after login %d" % _logins)
+	if not _got_nodes:
+		fail("no s2c_nodes after login %d" % _logins)
+
+
+func _plan() -> void:
+	_targets.clear()
+	_login_nodes = 0
+	for n in ResourceNodes.near(bot.my_pos, SEARCH_RADIUS):
+		if not ResourceNodes.kind_info(n.kind).get("night_only", false):
+			_targets.append(n.id)
+	_next_node()
+
+
+func _next_node() -> void:
+	if _targets.is_empty() or _login_nodes >= MAX_NODES:
+		_step = Step.IDLE
+		return
+	_target = _targets.pop_front()
+	_login_nodes += 1
+	nodes_tried += 1
+	_since = bot.elapsed
+	_step = Step.GOTO
+
+
+func _gathering() -> Object:
+	for b in bot.behaviours:
+		if b.name == "gameplay_gathering":
+			return b
+	return null
+
+
+func _send_start() -> void:
+	_tries += 1
+	_next_at = bot.elapsed + NO_ANSWER
+	bot.net.play.c2s_gather_start.rpc_id(1, _target)
+
+
+func on_play(_delta: float) -> void:
+	match _step:
+		Step.WAIT_FIRST:
+			var g = _gathering()
+			if g == null or (not g._active and g._phase_gathered):
+				_plan()
+		Step.GOTO:
+			var node := ResourceNodes.get_by_id(_target)
+			var off: Vector3 = node.pos - bot.my_pos
+			var flat := Vector2(off.x, off.z)
+			if bot.elapsed - _since > WALK_TIMEOUT:
+				_next_node()
+			elif flat.length() > STOP_AT:
+				bot.move = flat.normalized()
+				bot.yaw = atan2(bot.move.x, bot.move.y)
+			else:
+				bot.move = Vector2.ZERO
+				_step = Step.START
+				_tries = 0
+				_next_at = bot.elapsed + SETTLE
+		Step.START:
+			bot.move = Vector2.ZERO
+			if bot.elapsed >= _next_at:
+				if _tries >= MAX_TRIES:
+					_next_node()
+				else:
+					_send_start()
+		Step.WALKING:
+			bot.move = _walk
+			bot.yaw = atan2(_walk.x, _walk.y)
+			if bot.elapsed > _ends_by:
+				fail("walked away but the gather never ended")
+				_step = Step.IDLE
+		Step.STOPPING, Step.HOLDING:
+			bot.move = Vector2.ZERO
+			if bot.elapsed > _ends_by:
+				fail("timed gather never ended (%s at %s)" % [Step.keys()[_step], bot.my_pos])
+				_step = Step.IDLE
+
+
+func _on_began(peer: int, node_id: int, seconds: float) -> void:
+	if peer != bot.my_id:
+		others_seen += 1
+		if node_id == _target and _step in [Step.HOLDING, Step.STOPPING, Step.WALKING]:
+			shared_node += 1
+		return
+	if _step != Step.START or node_id != _target:
+		fail("s2c_gather_begin for node %d we did not ask for (step %s)" % [node_id, Step.keys()[_step]])
+		return
+	answered += 1
+	started += 1
+	if seconds <= 0.0:
+		fail("gather began without a duration")
+	_ends_by = bot.elapsed + seconds + END_SLACK
+	match _test:
+		Test.WALK_AWAY:
+			var a: float = bot.rng.randf() * TAU
+			_walk = Vector2(cos(a), sin(a))
+			_step = Step.WALKING
+		Test.CANCEL:
+			_step = Step.STOPPING
+			bot.net.play.c2s_gather_cancel.rpc_id(1)
+		_:
+			_step = Step.HOLDING
+
+
+func _on_ended(peer: int, node_id: int, reason: String) -> void:
+	if peer != bot.my_id or node_id != _target:
+		return
+	match _step:
+		Step.START:
+			answered += 1
+			refused += 1
+			if reason == "cooldown":
+				_next_at = bot.elapsed + 0.6 # the gather prompt's /gather just ran: soon
+			else:
+				_next_node()
+		Step.WALKING:
+			if reason == "done":
+				fail("walked away but the gather still paid out")
+				_step = Step.IDLE
+			elif reason in ["moved", "far"]:
+				walked_off += 1
+				_test = Test.CANCEL
+				_targets.push_front(_target) # it still has the charge we didn't take
+				_next_node()
+			else:
+				_contested()
+		Step.STOPPING:
+			if reason == "stopped":
+				stopped += 1
+				_test = Test.HOLD
+				_step = Step.START
+				_tries = 0
+				_next_at = bot.elapsed + 0.3
+			elif reason == "done":
+				fail("cancelled but the gather still paid out")
+				_step = Step.IDLE
+			else:
+				_contested()
+		Step.HOLDING:
+			if reason == "done":
+				completed += 1
+				_test = Test.DONE
+				_step = Step.IDLE
+			elif reason in ["moved", "far"]:
+				fail("gather cancelled (%s) while standing still at %s" % [reason, bot.my_pos])
+				_step = Step.IDLE
+			else:
+				_contested()
+
+
+## Another bot emptied the node while we gathered (or our pack filled): try the next one.
+func _contested() -> void:
+	contested += 1
+	_next_node()
+
+
+func _on_result(item: String, count: int) -> void:
+	if count <= 0 or item == "":
+		fail("empty gather result %s x%d" % [item, count])
+	_haul_item = item
+	_haul_count = count
+
+
+func _on_inventory(items: Dictionary) -> void:
+	_got_inventory = true
+	if _haul_item != "":
+		if int(items.get(_haul_item, 0)) < _haul_count:
+			fail("pack after the haul has %d %s, expected at least %d" % [int(items.get(_haul_item, 0)), _haul_item, _haul_count])
+		_haul_item = ""
+
+
+func on_finish() -> void:
+	if _logins > 0:
+		_check_login_state()
+	stat("started", started)
+	stat("completed", completed)
+	stat("walked_off", walked_off)
+	stat("stopped", stopped)
+	stat("contested", contested)
+	stat("refused", refused)
+	stat("others_seen", others_seen)
+	stat("shared_node", shared_node)
+	stat("node_states", node_states)
+	stat("nodes_tried", nodes_tried)
+	if bot.elapsed > 60.0 and answered == 0 and nodes_tried > 0:
+		fail("c2s_gather_start was never answered")
