diff --git a/game/shared/net_play.gd b/game/shared/net_play.gd
new file mode 100644
index 0000000..4c5cd2e
--- /dev/null
+++ b/game/shared/net_play.gd
@@ -0,0 +1,79 @@
+extends Node
+## Protocol v3's play RPCs: gathering, the pack, node state, crafting. Lives at
+## /root/Main/Net/Play on every peer (net.gd creates it in _ready), so the RPCs on Net itself
+## keep their numbers and old clients still reach the "out of date" reply (see
+## tests/protocol/README.md). Carries no logic: every RPC re-emits a signal on Net, so the
+## server, client and bots connect to `net.<signal>` as before and call
+## `net.play.<rpc>.rpc_id(...)` to send.
+
+
+func _net() -> Node:
+	return get_parent()
+
+
+# --- client to server ---
+
+## Press E at a node: start a timed gather on it (the server checks reach, night-only, pack
+## room and cooldown, and answers with s2c_gather_begin or s2c_gather_end with the reason).
+@rpc("any_peer", "call_remote", "reliable")
+func c2s_gather_start(node_id: int) -> void:
+	_net().gather_start_requested.emit(multiplayer.get_remote_sender_id(), node_id)
+
+
+## Stop the running gather (no charge used, no cooldown spent).
+@rpc("any_peer", "call_remote", "reliable")
+func c2s_gather_cancel() -> void:
+	_net().gather_cancel_requested.emit(multiplayer.get_remote_sender_id())
+
+
+## Craft one batch of `recipe_id` (an exact Crafting.RECIPES id) at the workbench.
+@rpc("any_peer", "call_remote", "reliable")
+func c2s_craft(recipe_id: String) -> void:
+	_net().craft_requested.emit(multiplayer.get_remote_sender_id(), recipe_id)
+
+
+# --- server to client ---
+
+## Player `peer_id` started gathering node `node_id`; it takes `seconds`. Sent to everyone in
+## view (GameConfig.VIEW_RANGE), the gatherer included.
+@rpc("authority", "call_remote", "reliable")
+func s2c_gather_begin(peer_id: int, node_id: int, seconds: float) -> void:
+	_net().gather_began.emit(peer_id, node_id, seconds)
+
+
+## Player `peer_id`'s gather on `node_id` ended: "done", or why not ("moved", "far",
+## "stopped", "disconnected", "depleted", "full", "cooldown", "night_only", ...). A refused
+## start goes to the requester only.
+@rpc("authority", "call_remote", "reliable")
+func s2c_gather_end(peer_id: int, node_id: int, reason: String) -> void:
+	_net().gather_ended.emit(peer_id, node_id, reason)
+
+
+## What your finished gather put in your pack, for the haul toast.
+@rpc("authority", "call_remote", "reliable")
+func s2c_gather_result(item_id: String, count: int) -> void:
+	_net().gather_result.emit(item_id, count)
+
+
+## Your whole pack, {item_id: count}: after login and whenever it changes (once per tick).
+@rpc("authority", "call_remote", "reliable")
+func s2c_inventory(items: Dictionary) -> void:
+	_net().inventory.emit(items)
+
+
+## Ids of every node that is used up right now. Sent once after login.
+@rpc("authority", "call_remote", "reliable")
+func s2c_nodes(depleted_ids: Array) -> void:
+	_net().nodes.emit(depleted_ids)
+
+
+## One node emptied (`depleted` true) or came back. Sent to everyone online.
+@rpc("authority", "call_remote", "reliable")
+func s2c_node_state(node_id: int, depleted: bool) -> void:
+	_net().node_state.emit(node_id, depleted)
+
+
+## The answer to c2s_craft: `text` says what happened, for the window's status line.
+@rpc("authority", "call_remote", "reliable")
+func s2c_craft_result(recipe_id: String, ok: bool, text: String) -> void:
+	_net().craft_result.emit(recipe_id, ok, text)
