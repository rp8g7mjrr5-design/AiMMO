 func _on_peer_connected(id: int) -> void:
@@ -481,6 +484,43 @@ func gather_request(id: int, node_id: int) -> Dictionary:
 	return r
 
 
+## c2s_gather_start(node_id) (protocol v3: press E at a node). Not logged in: ignored.
+func _on_gather_start(id: int, node_id: int) -> void:
+	if not _play_allowed(id, "last_play_gather"):
+		return
+	gather_request(id, node_id)
+
+
+## c2s_gather_cancel(): the player stopped on purpose.
+func _on_gather_cancel(id: int) -> void:
+	if sessions.has(id) and sessions[id].logged_in:
+		gather_cancel(id, "stopped")
+
+
+## c2s_craft(recipe_id) from the crafting window.
+func _on_craft(id: int, recipe_id: String) -> void:
+	if not _play_allowed(id, "last_play_craft"):
+		return
+	craft_request(id, recipe_id)
+
+
+## Requests that can make the server reply (gather start, craft) are taken at most once
+## every PLAY_REQUEST_GAP per kind, so a flooding client can't make the server spam back.
+## A real key press or button click is never that fast.
+const PLAY_REQUEST_GAP := 0.1
+
+
+func _play_allowed(id: int, key: String) -> bool:
+	if not sessions.has(id) or not sessions[id].logged_in:
+		return false
+	var s: Dictionary = sessions[id]
+	var now := now_seconds()
+	if now - float(s.get(key, -1000.0)) < PLAY_REQUEST_GAP:
+		return false
+	s[key] = now
+	return true
+
+
