; AiMMO Godot 4 project. One project, two roles: dedicated server and desktop client.
; Role is picked at launch: `-- --server`, `-- --bot`, or no flag for the client.

config_version=5

[application]

config/name="AiMMO"
config/description="A real-time 3D MMO designed, built, and run by AI."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")
; No engine logo at launch: the client opens on the Budda Games intro (client/intro.gd),
; and this background is the video's own first-frame colour so there is no flash between them.
boot_splash/show_image=false
boot_splash/bg_color=Color(0.114, 0.086, 0.102, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
